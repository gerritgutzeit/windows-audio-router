<UserControl
    x:Class="AudioPresetSwitcher.Views.Controls.CurrentAudioStatusView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:windows="clr-namespace:AudioPresetSwitcher.ViewModels.Windows"
    d:DataContext="{d:DesignInstance windows:CurrentAudioStatusViewModel}"
    Cursor="Hand"
    MouseLeftButtonUp="OnMouseLeftButtonUp"
    mc:Ignorable="d">
    <UserControl.Resources>
        <Style x:Key="CompactPeakMeterStyle" TargetType="ProgressBar">
            <Setter Property="Height" Value="4" />
            <Setter Property="Minimum" Value="0" />
            <Setter Property="Maximum" Value="100" />
            <Setter Property="Foreground" Value="{DynamicResource AccentFillColorDefaultBrush}" />
            <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMuted}" Value="True">
                    <Setter Property="Opacity" Value="0.35" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="EndpointNameStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasDevice}" Value="False">
                    <Setter Property="FontWeight" Value="Normal" />
                    <Setter Property="Opacity" Value="0.56" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <ui:Card Margin="12,4,12,12" Padding="12">
        <StackPanel>
            <Grid DataContext="{Binding Playback}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border
                    Width="28"
                    Height="28"
                    Margin="0,0,10,0"
                    VerticalAlignment="Top"
                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                    CornerRadius="8">
                    <ui:SymbolIcon
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="14"
                        Symbol="{Binding IconSymbol}" />
                </Border>
                <StackPanel Grid.Column="1">
                    <TextBlock
                        FontSize="11"
                        Opacity="0.56"
                        Text="Headphones" />
                    <TextBlock
                        Style="{StaticResource EndpointNameStyle}"
                        Text="{Binding Name}" />
                    <ProgressBar
                        Margin="0,6,0,0"
                        Style="{StaticResource CompactPeakMeterStyle}"
                        Value="{Binding Peak, Mode=OneWay}" />
                </StackPanel>
            </Grid>

            <Grid Margin="0,10,0,0" DataContext="{Binding Recording}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border
                    Width="28"
                    Height="28"
                    Margin="0,0,10,0"
                    VerticalAlignment="Top"
                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                    CornerRadius="8">
                    <ui:SymbolIcon
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="14"
                        Symbol="{Binding IconSymbol}" />
                </Border>
                <StackPanel Grid.Column="1">
                    <TextBlock
                        FontSize="11"
                        Opacity="0.56"
                        Text="Microphone" />
                    <TextBlock
                        Style="{StaticResource EndpointNameStyle}"
                        Text="{Binding Name}" />
                    <ProgressBar
                        Margin="0,6,0,0"
                        Style="{StaticResource CompactPeakMeterStyle}"
                        Value="{Binding Peak, Mode=OneWay}" />
                </StackPanel>
            </Grid>
        </StackPanel>
    </ui:Card>
</UserControl>
