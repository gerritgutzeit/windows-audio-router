<Page
    x:Class="AudioPresetSwitcher.Views.Pages.PresetsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:converters="clr-namespace:AudioPresetSwitcher.Converters"
    xmlns:pages="clr-namespace:AudioPresetSwitcher.ViewModels.Pages"
    d:DataContext="{d:DesignInstance pages:PresetsViewModel}"
    ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
    ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    mc:Ignorable="d">
    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis" />
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Margin="0,8,0,18">
            <StackPanel>
                <TextBlock
                    FontSize="28"
                    FontWeight="SemiBold"
                    Text="Presets" />
                <TextBlock
                    Margin="0,4,0,0"
                    Opacity="0.72"
                    Text="One-click playback and recording layouts. Calls use the same devices." />
            </StackPanel>
            <ui:Button
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Appearance="Primary"
                Command="{Binding ViewModel.CreateCommand}"
                Content="New preset"
                Icon="{ui:SymbolIcon Add24}" />
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <ui:InfoBar
                    Title="No presets yet"
                    IsClosable="False"
                    IsOpen="True"
                    Message="Create a preset to switch speakers, headsets, and microphones from the tray or Stream Deck."
                    Severity="Informational"
                    Visibility="{Binding ViewModel.HasPresets, Converter={StaticResource InverseBoolToVis}}" />

                <ItemsControl ItemsSource="{Binding ViewModel.Presets}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type pages:PresetCardViewModel}">
                            <ui:Card Margin="0,0,0,12" Padding="18">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border
                                        Width="48"
                                        Height="48"
                                        Margin="0,0,16,0"
                                        Background="{DynamicResource ControlFillColorDefaultBrush}"
                                        CornerRadius="8">
                                        <ui:SymbolIcon
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontSize="24"
                                            Symbol="{Binding IconSymbol}" />
                                    </Border>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock
                                            FontSize="16"
                                            FontWeight="SemiBold"
                                            Text="{Binding Name}" />
                                        <TextBlock
                                            Margin="0,4,0,0"
                                            Opacity="0.72"
                                            Text="{Binding Subtitle}"
                                            TextTrimming="CharacterEllipsis" />
                                    </StackPanel>

                                    <StackPanel
                                        Grid.Column="2"
                                        VerticalAlignment="Center"
                                        Orientation="Horizontal">
                                        <ui:Button
                                            MinWidth="118"
                                            Appearance="Primary"
                                            Command="{Binding ActivateCommand}"
                                            Content="Activate"
                                            Visibility="{Binding IsActive, Converter={StaticResource InverseBoolToVis}}" />
                                        <ui:Button
                                            MinWidth="118"
                                            Appearance="Secondary"
                                            Content="Active"
                                            IsEnabled="False"
                                            Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}" />
                                        <ui:Button
                                            Width="40"
                                            Margin="8,0,0,0"
                                            Padding="0"
                                            Appearance="Secondary"
                                            Click="OnMoreClick"
                                            Icon="{ui:SymbolIcon ChevronDown24}">
                                            <ui:Button.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem
                                                        Click="OnEditClick"
                                                        Header="Edit" />
                                                    <MenuItem
                                                        Click="OnDuplicateClick"
                                                        Header="Duplicate" />
                                                    <MenuItem
                                                        Click="OnCreateShortcutClick"
                                                        Header="Create shortcut..." />
                                                    <MenuItem
                                                        Click="OnDeleteClick"
                                                        Header="Delete" />
                                                </ContextMenu>
                                            </ui:Button.ContextMenu>
                                        </ui:Button>
                                    </StackPanel>
                                </Grid>
                            </ui:Card>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
