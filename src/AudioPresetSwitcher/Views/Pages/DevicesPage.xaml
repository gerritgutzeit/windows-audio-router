<Page
    x:Class="AudioPresetSwitcher.Views.Pages.DevicesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:converters="clr-namespace:AudioPresetSwitcher.Converters"
    xmlns:pages="clr-namespace:AudioPresetSwitcher.ViewModels.Pages"
    d:DataContext="{d:DesignInstance pages:DevicesViewModel}"
    ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
    ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    mc:Ignorable="d">
    <Page.Resources>
        <converters:NullOrEmptyToVisibilityConverter x:Key="EmptyToVis" />
        <DataTemplate x:Key="DeviceCardTemplate" DataType="{x:Type pages:LiveDeviceCardViewModel}">
            <ui:Card Margin="0,0,0,12" Padding="18">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border
                        Width="48"
                        Height="48"
                        Margin="0,0,16,0"
                        Background="{DynamicResource ControlFillColorDefaultBrush}"
                        CornerRadius="8">
                        <ui:SymbolIcon
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="24"
                            Symbol="{Binding IconSymbol}" />
                    </Border>
                    <StackPanel Grid.Column="1">
                        <DockPanel LastChildFill="False">
                            <TextBlock
                                DockPanel.Dock="Left"
                                FontSize="16"
                                FontWeight="SemiBold"
                                Text="{Binding Name}"
                                TextTrimming="CharacterEllipsis" />
                            <ui:InfoBadge
                                Margin="8,0,0,0"
                                DockPanel.Dock="Right"
                                Severity="Informational"
                                Visibility="{Binding CommunicationsBadge, Converter={StaticResource EmptyToVis}}"
                                Value="{Binding CommunicationsBadge}" />
                            <ui:InfoBadge
                                Margin="8,0,0,0"
                                DockPanel.Dock="Right"
                                Severity="Success"
                                Visibility="{Binding DefaultBadge, Converter={StaticResource EmptyToVis}}"
                                Value="{Binding DefaultBadge}" />
                        </DockPanel>
                        <TextBlock
                            Margin="0,4,0,8"
                            Opacity="0.72"
                            Text="{Binding StatusText}" />
                        <ProgressBar
                            Height="6"
                            Maximum="100"
                            Minimum="0"
                            Value="{Binding Peak, Mode=OneWay}" />
                    </StackPanel>
                </Grid>
            </ui:Card>
        </DataTemplate>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock
                Margin="0,8,0,4"
                FontSize="28"
                FontWeight="SemiBold"
                Text="Live status" />
            <TextBlock
                Margin="0,0,0,20"
                Opacity="0.72"
                Text="Connected playback and recording devices, with live levels." />

            <TextBlock
                Margin="0,0,0,10"
                FontSize="16"
                FontWeight="SemiBold"
                Text="Playback" />
            <ItemsControl ItemTemplate="{StaticResource DeviceCardTemplate}" ItemsSource="{Binding ViewModel.PlaybackDevices}" />

            <TextBlock
                Margin="0,16,0,10"
                FontSize="16"
                FontWeight="SemiBold"
                Text="Recording" />
            <ItemsControl ItemTemplate="{StaticResource DeviceCardTemplate}" ItemsSource="{Binding ViewModel.RecordingDevices}" />
        </StackPanel>
    </ScrollViewer>
</Page>
